{
  "name": "wunabuy-backend",
  "version": "1.0.0",
  "description": "Wunabuy backend API server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:coverage": "jest --coverage",
    "migrate:local": "supabase db reset --local",
    "migrate:dev": "supabase db push --linked",
    "migrate:staging": "supabase db push --linked --db-url $STAGING_DATABASE_URL",
    "migrate:prod": "supabase db push --linked --db-url $PROD_DATABASE_URL",
    "seed:local": "tsx src/scripts/seed.ts",
    "generate:openapi": "tsx src/scripts/generate-openapi.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "@supabase/supabase-js": "^2.45.0",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "otplib": "^12.0.1",
    "axios": "^1.7.2",
    "pino": "^9.1.0",
    "sharp": "^0.33.4",
    "multer": "^1.4.5-lts.1",
    "express-rate-limit": "^7.4.0",
    "rate-limit-redis": "^7.0.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "uuid": "^10.0.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "firebase-admin": "^12.1.1",
    "@mux/mux-node": "^8.0.0",
    "pdfkit": "^0.13.0",
    "@turf/turf": "^7.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "tsx": "^4.15.0",
    "@types/node": "^20.14.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^1.4.11",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^10.0.0",
    "@types/pdfkit": "^0.13.0",
    "@types/node-cron": "^3.0.11",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "pino-pretty": "^11.2.0",
    "supabase": "^1.183.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
