# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wunabuy"

# JWT Secrets
JWT_SECRET="change-me-to-a-random-string"
JWT_EXPIRES_IN="7d"

# ─── MTN Mobile Money (MoMo) ─────────────────────────────────────────────────
# Docs: https://momodeveloper.mtn.com/  |  Register at MTN Developer Portal
# Set MTN_MOMO_STUB_MODE=false when your licence is approved
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_API_KEY=""                       # Insert from MTN Developer Portal
MTN_MOMO_API_SECRET=""                    # Insert from MTN Developer Portal
MTN_MOMO_SUBSCRIPTION_KEY=""              # Insert from MTN Developer Portal
MTN_MOMO_TARGET_ENV="sandbox"             # Change to: production
MTN_MOMO_STUB_MODE=true                   # Change to: false when licensed
MTN_MOMO_WEBHOOK_SECRET=""                # For HMAC signature verification
MTN_MOMO_TIMEOUT=30

# ─── Orange Money (Cameroon) ──────────────────────────────────────────────────
# Docs: https://developer.orange.com/apis/om-webpay-cm
# Set ORANGE_MONEY_STUB_MODE=false when your licence is approved
ORANGE_MONEY_BASE_URL="https://api.orange.com/orange-money-webpay/cm/v1"
ORANGE_MONEY_CLIENT_ID=""                 # Insert from Orange Developer Portal
ORANGE_MONEY_CLIENT_SECRET=""             # Insert from Orange Developer Portal
ORANGE_MONEY_MERCHANT_KEY=""              # Insert from Orange Developer Portal
ORANGE_MONEY_STUB_MODE=true               # Change to: false when licensed
ORANGE_MONEY_WEBHOOK_SECRET=""            # For notif_url verification
ORANGE_MONEY_TIMEOUT=30

# ─── Escrow & Fee Configuration ───────────────────────────────────────────────
ESCROW_COMMISSION_RATE=0.035              # 3.5% platform fee on subtotal
PAYOUT_FEE_RATE=0.015                    # 1.5% withdrawal processing fee
PAYOUT_FEE_CAP=500                        # Max withdrawal fee in XAF
MIN_WITHDRAWAL=100                        # Min withdrawal in XAF
MIN_DEPOSIT=100                           # Min top-up in XAF
DEFAULT_DELIVERY_FEE=1500                # Default delivery fee in XAF
REGISTRATION_BONUS=100                    # New-user reward in XAF (non-withdrawable)
LARGE_PAYOUT_THRESHOLD=100000            # Payouts >= this need staff approval
ESCROW_AUTO_RELEASE_HOURS=48             # Auto-release timeout after delivery

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Google Maps ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=""
